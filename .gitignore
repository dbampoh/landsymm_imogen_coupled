_chat_artifacts/b8_2_5_switchable_regrid_2026-05-26/phase_d_ssp126_canary_v*.log
_chat_artifacts/b8_2_5_switchable_regrid_2026-05-26/phase_e_fastregrid_*.log
_chat_artifacts/b8_2_5_switchable_regrid_2026-05-26/phase_e_fortran_*.log
_chat_artifacts/b8_2_5_switchable_regrid_2026-05-26/phase_c_canary_output/
